x = "Basket Value (VND)",
y = "Number of Orders",
fill = "Transaction Group"
) +
# Format x-axis
scale_x_continuous(
labels = scales::label_number(
big.mark = ","
)
) +
# Colors
scale_fill_manual(
values = c(
"Below 80th Percentile" = "grey60",
"Top 20% - High Value" = "#2A9D8F"
)
) +
# Clean theme
theme_minimal(base_size = 13) +
theme(
