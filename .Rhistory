# ------------------------------------------------------------
# Combine categorical results
# ------------------------------------------------------------
categorical_imputation_comparison <- bind_rows(
categorical_before,
categorical_after
) %>%
mutate(
variable = case_when(
variable == "payment_method" ~
"Payment method",
variable == "promo_code_used" ~
"Promo code",
variable == "traffic_level" ~
"Traffic level",
variable == "weather_condition" ~
"Weather condition",
TRUE ~ variable
)
)
categorical_imputation_comparison
# ============================================================
# 15.6.3 NUMERICAL IMPUTATION VISUAL
# ============================================================
numerical_imputation_plot <- ggplot(
numeric_imputation_comparison,
aes(
x = variable,
y = mean_value,
fill = stage
)
) +
geom_col(
position = position_dodge(
width = 0.75
),
width = 0.65
) +
labs(
title = "Numerical Imputation Impact",
subtitle = "Mean values before and after median imputation",
x = NULL,
y = "Mean value",
fill = "Data stage"
) +
scale_y_continuous(
labels = scales::label_number(
big.mark = ","
)
) +
theme_minimal(
base_size = 13
) +
theme(
plot.title = element_text(
face = "bold",
size = 15
),
plot.subtitle = element_text(
size = 10
),
axis.text.x = element_text(
size = 10
),
panel.grid.minor = element_blank(),
legend.position = "bottom"
)
numerical_imputation_plot
# ============================================================
# 15.6.4 CATEGORICAL IMPUTATION VISUAL
# ============================================================
categorical_imputation_plot <- ggplot(
categorical_imputation_comparison,
aes(
x = variable,
y = percentage,
fill = stage
)
) +
geom_col(
width = 0.65,
position = position_dodge(
width = 0.75
)
) +
labs(
title = "Categorical Missing-Value Treatment",
subtitle = "Missing values were retained as an explicit Unknown category",
x = NULL,
y = "Percentage of observations (%)",
fill = "Data stage"
) +
scale_y_continuous(
limits = c(0, NA),
expand = expansion(
mult = c(0, 0.05)
)
) +
theme_minimal(
base_size = 13
) +
theme(
plot.title = element_text(
face = "bold",
size = 15
),
plot.subtitle = element_text(
size = 10
),
axis.text.x = element_text(
size = 10
),
panel.grid.minor = element_blank(),
legend.position = "bottom"
)
categorical_imputation_plot
# ============================================================
# 15.6.5 SAVE VISUALS
# ============================================================
ggsave(
"figures/02_numerical_imputation_impact.png",
numerical_imputation_plot,
width = 10,
height = 7,
dpi = 300
)
ggsave(
"figures/03_categorical_imputation_impact.png",
categorical_imputation_plot,
width = 11,
height = 7,
dpi = 300
)
# ============================================================
# 15.6 IMPUTATION IMPACT ASSESSMENT
# ============================================================
# ============================================================
# 15.6.1 NUMERICAL IMPUTATION COMPARISON
# ============================================================
# ------------------------------------------------------------
# Calculate BEFORE-imputation means
# ------------------------------------------------------------
before_numeric <- model_data %>%
summarise(
customer_age = mean(
customer_age,
na.rm = TRUE
),
distance_km_clean = mean(
distance_km_clean,
na.rm = TRUE
)
) %>%
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "mean_value"
) %>%
mutate(
stage = "Before imputation"
)
# ------------------------------------------------------------
# Calculate AFTER-imputation means
# ------------------------------------------------------------
after_numeric <- final_model_data %>%
summarise(
customer_age = mean(
customer_age
),
distance_km_clean = mean(
distance_km_clean
)
) %>%
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "mean_value"
) %>%
mutate(
stage = "After imputation"
)
# ------------------------------------------------------------
# Combine numerical results
# ------------------------------------------------------------
numeric_imputation_comparison <- bind_rows(
before_numeric,
after_numeric
) %>%
mutate(
variable = case_when(
variable == "customer_age" ~
"Customer age",
variable == "distance_km_clean" ~
"Distance (km)",
TRUE ~ variable
)
)
numeric_imputation_comparison
# ============================================================
# 15.6.2 CATEGORICAL IMPUTATION COMPOSITION
# ============================================================
categorical_impute_vars <- c(
"payment_method",
"promo_code_used",
"traffic_level",
"weather_condition"
)
# ------------------------------------------------------------
# Calculate categorical composition AFTER imputation
# ------------------------------------------------------------
categorical_imputation_composition <- final_model_data %>%
select(
all_of(categorical_impute_vars)
) %>%
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "category"
) %>%
group_by(
variable,
category
) %>%
summarise(
n = n(),
.groups = "drop"
) %>%
group_by(
variable
) %>%
mutate(
percentage = n / sum(n) * 100
) %>%
ungroup() %>%
mutate(
variable = case_when(
variable == "payment_method" ~
"Payment method",
variable == "promo_code_used" ~
"Promo code",
variable == "traffic_level" ~
"Traffic level",
variable == "weather_condition" ~
"Weather condition",
TRUE ~ variable
)
)
# ------------------------------------------------------------
# View composition
# ------------------------------------------------------------
categorical_imputation_composition
# ============================================================
# 15.6.3 CATEGORICAL COMPOSITION VISUAL
# ============================================================
categorical_imputation_plot <- ggplot(
categorical_imputation_composition,
aes(
x = variable,
y = percentage,
fill = category
)
) +
geom_col(
width = 0.7
) +
labs(
title = "Categorical Variables After Imputation",
subtitle = "Missing values are retained as an explicit Unknown category",
x = NULL,
y = "Percentage of observations (%)",
fill = "Category"
) +
scale_y_continuous(
limits = c(0, 100),
breaks = seq(0, 100, 20),
expand = expansion(
mult = c(0, 0)
)
) +
theme_minimal(
base_size = 13
) +
theme(
plot.title = element_text(
face = "bold",
size = 16,
family = "sans"
),
plot.subtitle = element_text(
size = 11,
family = "sans"
),
axis.text.x = element_text(
size = 10,
family = "sans"
),
axis.text.y = element_text(
size = 10,
family = "sans"
),
axis.title.y = element_text(
size = 11,
family = "sans"
),
panel.grid.minor = element_blank(),
legend.position = "right",
legend.title = element_text(
size = 10
),
legend.text = element_text(
size = 9
),
plot.margin = ggplot2::margin(
t = 10,
r = 15,
b = 15,
l = 15
)
)
categorical_imputation_plot
# ============================================================
# 15.6 IMPUTATION IMPACT ASSESSMENT
# ============================================================
# ============================================================
# 15.6.1 NUMERICAL IMPUTATION COMPARISON
# ============================================================
# ------------------------------------------------------------
# Calculate BEFORE-imputation means
# ------------------------------------------------------------
before_numeric <- model_data %>%
summarise(
customer_age = mean(
customer_age,
na.rm = TRUE
),
distance_km_clean = mean(
distance_km_clean,
na.rm = TRUE
)
) %>%
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "mean_value"
) %>%
mutate(
stage = "Before imputation"
)
# ------------------------------------------------------------
# Calculate AFTER-imputation means
# ------------------------------------------------------------
after_numeric <- final_model_data %>%
summarise(
customer_age = mean(
customer_age
),
distance_km_clean = mean(
distance_km_clean
)
) %>%
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "mean_value"
) %>%
mutate(
stage = "After imputation"
)
# ------------------------------------------------------------
# Combine numerical results
# ------------------------------------------------------------
numeric_imputation_comparison <- bind_rows(
before_numeric,
after_numeric
) %>%
mutate(
variable = case_when(
variable == "customer_age" ~
"Customer age",
variable == "distance_km_clean" ~
"Distance (km)",
TRUE ~ variable
)
)
numeric_imputation_comparison
# ============================================================
# 15.6.2 CATEGORICAL IMPUTATION SUMMARY
# ============================================================
categorical_impute_vars <- c(
"payment_method",
"promo_code_used",
"traffic_level",
"weather_condition"
)
# ------------------------------------------------------------
# Calculate percentage converted to "Unknown"
# ------------------------------------------------------------
categorical_unknown_summary <- final_model_data %>%
summarise(
across(
all_of(categorical_impute_vars),
~ mean(. == "Unknown") * 100
)
) %>%
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "unknown_percentage"
) %>%
mutate(
variable = case_when(
variable == "payment_method" ~
"Payment method",
variable == "promo_code_used" ~
"Promo code",
variable == "traffic_level" ~
"Traffic level",
variable == "weather_condition" ~
"Weather condition",
TRUE ~ variable
)
)
categorical_unknown_summary
# ============================================================
# 15.6.3 CATEGORICAL IMPUTATION VISUAL
# ============================================================
categorical_imputation_plot <- ggplot(
categorical_unknown_summary,
aes(
x = reorder(
variable,
unknown_percentage
),
y = unknown_percentage
)
) +
geom_col(
width = 0.6,
fill = "#2A9D8F"
) +
geom_text(
aes(
label = paste0(
round(
unknown_percentage,
1
),
"%"
)
),
hjust = -0.15,
size = 4
) +
coord_flip() +
labs(
title = "Categorical Missing-Value Imputation",
subtitle = "Percentage of observations assigned to the Unknown category",
x = NULL,
y = "Unknown values (%)"
) +
scale_y_continuous(
expand = expansion(
mult = c(
0,
0.15
)
)
) +
theme_minimal(
base_size = 13
) +
theme(
plot.title = element_text(
face = "bold",
size = 16,
family = "sans"
),
plot.subtitle = element_text(
size = 11,
family = "sans"
),
axis.text.y = element_text(
size = 10,
family = "sans"
),
axis.text.x = element_text(
size = 10,
family = "sans"
),
axis.title.x = element_text(
size = 11,
family = "sans"
),
panel.grid.minor = element_blank(),
plot.margin = ggplot2::margin(
t = 10,
r = 25,
b = 15,
l = 15
)
)
categorical_imputation_plot
# ============================================================
# 15.6.4 SAVE VISUAL
# ============================================================
ggsave(
"figures/03_categorical_imputation_impact.png",
categorical_imputation_plot,
width = 10,
height = 7,
dpi = 300
)
